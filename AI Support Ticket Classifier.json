        "jsCode": "// Get the AI response\nconst aiOutput = $input.first().json.text;\n\ntry {\n  // Parse the JSON returned by Gemini\n  const parsed = JSON.parse(aiOutput);\n\n  return [\n    {\n      json: parsed\n    }\n  ];\n} catch (error) {\n  throw new Error(\"Gemini did not return valid JSON.\\n\\nResponse:\\n\" + aiOutput);\n}"
